{
  "collections": [
    {
      "name": "posts",
      "type": "base",
      "fields": [
        { "name": "title", "type": "text", "required": true },
        { "name": "body", "type": "editor" },
        { "name": "views", "type": "number" },
        { "name": "rating", "type": "number", "required": true },
        { "name": "published", "type": "bool" },
        { "name": "pinned", "type": "bool", "required": true },
        { "name": "status", "type": "select", "options": { "values": ["draft", "live"] } },
        { "name": "tags", "type": "select", "options": { "multiple": true, "values": ["a", "b"] } },
        { "name": "cover", "type": "file" },
        { "name": "gallery", "type": "file", "options": { "multiple": true } },
        { "name": "author", "type": "relation", "collection": "users" },
        { "name": "publish_at", "type": "date" },
        { "name": "edited", "type": "autodate", "onUpdate": true },
        { "name": "meta", "type": "json" },
        { "name": "place", "type": "geoPoint" },
        { "name": "embedding", "type": "vector", "options": { "dimensions": 3 } },
        { "name": "contact", "type": "email" },
        { "name": "site", "type": "url" },
        { "name": "accent", "type": "color" },
        { "name": "class", "type": "text" },
        { "name": "data", "type": "text" },
        { "name": "to_json", "type": "text" },
        { "name": "secret", "type": "password" }
      ]
    },
    {
      "name": "users",
      "type": "auth",
      "fields": [
        { "name": "email", "type": "email", "implicit": true },
        { "name": "verified", "type": "bool", "implicit": true },
        { "name": "name", "type": "text", "required": true },
        { "name": "avatar", "type": "file" }
      ]
    },
    {
      "name": "orders",
      "type": "base",
      "fields": [
        { "name": "items", "type": "group", "required": true, "options": { "max": 10, "fields": [
          { "name": "sku", "type": "text", "required": true },
          { "name": "qty", "type": "number", "required": true },
          { "name": "price", "type": "number" },
          { "name": "gift", "type": "bool" },
          { "name": "size", "type": "select", "options": { "values": ["S", "M"] } },
          { "name": "tags", "type": "select", "options": { "multiple": true, "values": ["x", "y"] } },
          { "name": "ship_on", "type": "date" },
          { "name": "extra", "type": "json" },
          { "name": "class", "type": "text" },
          { "name": "to_json", "type": "text" }
        ] } },
        { "name": "address", "type": "group", "options": { "multiple": false, "fields": [
          { "name": "city", "type": "text", "required": true },
          { "name": "zip", "type": "text" },
          { "name": "since", "type": "date", "required": true }
        ] } }
      ]
    },
    {
      "name": "post_stats",
      "type": "view",
      "fields": [{ "name": "count", "type": "number" }]
    },
    {
      "name": "site_settings",
      "type": "singleton",
      "fields": [{ "name": "headline", "type": "text", "required": true }]
    },
    {
      "name": "empty",
      "type": "base",
      "fields": "[]"
    }
  ]
}
